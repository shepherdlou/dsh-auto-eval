{
  "name": "dsh-auto-eval",
  "version": "0.2.0",
  "description": "Auto-eval and hillclimbing for DeepSeek Harness: error analysis first, one grader per failure mode, calibrated LLM judges, and train/test-gated hillclimbing.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "evals",
    "llm-as-judge",
    "hillclimbing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepherdlou/dsh-auto-eval.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./lib/core/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "bin",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "bin": {
    "dsh-auto-eval": "./bin/dsh-auto-eval.mjs"
  }
}
